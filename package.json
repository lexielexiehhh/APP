{
  "name": "app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend \"npm run dev:backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "cd backend && .venv/bin/python main.py --reload",
    "start:backend": "cd backend && .venv/bin/python main.py",
    "build": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
